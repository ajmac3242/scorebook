{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.[jt]s?(x)",
      "<rootDir>/src/**/*.test.[jt]s?(x)"
    ]
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "^64.3.4",
    "jest": "30.4.2",
    "jest-environment-node": "30.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1125.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/lib-dynamodb": "^3.1125.0",
    "@smithy/config-resolver": "^4.7.2",
    "uuid": "14.0.2"
  }
}
