{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:jules": "jest --testPathPattern",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid)/)"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "@swc/jest"
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.[jt]s?(x)",
      "<rootDir>/src/**/*.test.[jt]s?(x)"
    ]
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "29.5.14",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "10.3.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "jest": "29.7.0",
    "jest-environment-node": "29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1044.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/lib-dynamodb": "^3.1044.0",
    "uuid": "14.0.0"
  }
}
